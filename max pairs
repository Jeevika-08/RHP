#include <iostream>
#include <algorithm>
#include <vector>
using namespace std;

int main(){
  int n,m;
  cin>>n>>m;
  int arr[n];
  int arr1[m];
  for(int i=0;i<n;i++){
    cin>>arr[i];
  }
  for (int j=0;j<m;j++){
    cin>>arr1[j];
  }
  int count=0;
  sort(arr,arr+n);
  sort(arr1,arr1+m);
  for(int i=n-1, j=m-1;j>=0 && i>=0;){
      if(arr1[j]<=2*arr[i]){
        count++; i--; j--;
      }else{
        j--;
      }
    }
  cout<<count;
} give name of code
