class Solution {
public:
    int dir[4][2] = {{0,1}, {0,-1}, {-1,0}, {1,0}};

    int dfs(vector<vector<int>>& matrix, vector<vector<int>>& dp, int r, int c) {
        if (dp[r][c] != 0)
            return dp[r][c];

        int R = matrix.size();
        int C = matrix[0].size();

        int best = 1;

        for (int i = 0; i < 4; i++) {
            int nr = r + dir[i][0];
            int nc = c + dir[i][1];

            if (nr >= 0 && nr < R && nc >= 0 && nc < C &&
                matrix[nr][nc] > matrix[r][c]) {
                best = max(best, 1 + dfs(matrix, dp, nr, nc));
            }
        }

        return dp[r][c] = best;
    }

    int longestIncreasingPath(vector<vector<int>>& matrix) {
        int R = matrix.size();
        int C = matrix[0].size();

        vector<vector<int>> dp(R, vector<int>(C, 0));
        int ans = 1;

        for (int r = 0; r < R; r++) {
            for (int c = 0; c < C; c++) {
                ans = max(ans, dfs(matrix, dp, r, c));
            }
        }

        return ans;
    }
};
